# Claude Code
.claude

# Dependencies
node_modules/

# Build output
# `assets/built/` is deliberately NOT ignored — see .gitattributes. Ghost can
# install a theme straight from a repo's default-branch zipball, which carries
# only tracked files, so the Vite output has to be committed for that install
# path to produce a working theme. Same convention as Casper and Source.
dist/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment
.env
.env.local

# Theme package
*.zip

# Scratch file written + removed by scripts/release.mjs
.release-notes.md
